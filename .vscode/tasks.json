{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cargo",
      "command": "build",
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "rust: cargo build"
    },
    {
      "label": "Run all tests",
      "type": "cargo",
      "command": "test",
      "args": ["-p", "archodex-backend"],
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Run unit tests",
      "type": "cargo",
      "command": "test",
      "args": ["-p", "archodex-backend", "--lib"],
      "problemMatcher": ["$rustc"],
      "group": "test"
    },
    {
      "label": "Run integration tests",
      "type": "cargo",
      "command": "test",
      "args": ["-p", "archodex-backend", "--test", "*"],
      "problemMatcher": ["$rustc"],
      "group": "test"
    },
    {
      "label": "Run specific test (with output)",
      "type": "cargo",
      "command": "test",
      "args": ["-p", "archodex-backend", "${input:testName}", "--", "--nocapture"],
      "problemMatcher": ["$rustc"],
      "group": "test"
    },
    {
      "type": "shell",
      "command": "surreal sql --endpoint rocksdb://db --namespace archodex --pretty --multi",
      "problemMatcher": [],
      "label": "surreal: SQL CLI to self-hosted database at ./db"
    },
    {
      "type": "shell",
      "command": "act --platform ubuntu-latest=catthehacker/ubuntu:act-24.04 --platform linux/amd64 --artifact-server-path /tmp/act-artifacts --workflows .github/workflows/build-dev.yml --use-new-action-cache --reuse",
      "problemMatcher": [],
      "group": {
        "kind": "build"
      },
      "label": "act: Run GitHub Actions Workflow build-dev.yml to build arm container image"
    }
  ],
  "inputs": [
    {
      "id": "testName",
      "type": "promptString",
      "description": "Test name or pattern to run",
      "default": ""
    }
  ]
}
